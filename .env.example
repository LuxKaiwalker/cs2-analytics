# All settings are optional; these are the defaults. Prefix: CS2A_
# Copy to .env to override.

# --- Storage -----------------------------------------------------------------
# Root for uploaded demos, the SQLite DB, cached map assets and temp files.
# Kept OUTSIDE any publicly served directory on purpose.
CS2A_DATA_DIR=./data

# --- Upload limits -----------------------------------------------------------
# Hard cap on a single uploaded/imported demo, in bytes. Default 400 MiB.
# Chosen from measured parser memory use — see docs/awpy-probe.md.
CS2A_MAX_DEMO_BYTES=419430400
# Minimum plausible demo size, in bytes. Smaller bodies are rejected outright.
CS2A_MIN_DEMO_BYTES=65536
# Total disk budget for stored demos, in bytes. Default 20 GiB.
CS2A_MAX_TOTAL_BYTES=21474836480

# --- Worker ------------------------------------------------------------------
# Wall-clock limit for one parse job, in seconds.
CS2A_PARSE_TIMEOUT_S=900
# Address-space limit for the parser subprocess, in MiB. An OOM becomes a clean
# failure instead of inviting the kernel OOM killer.
CS2A_WORKER_MEM_LIMIT_MB=3072
# Re-enqueue attempts after an interrupted run before marking a match failed.
CS2A_MAX_ATTEMPTS=2
# Keep the .dem file after a successful parse (needed to re-ingest on a schema
# bump). Set false to delete it and keep only the derived analytics.
CS2A_KEEP_DEMO_FILES=true

# --- URL import --------------------------------------------------------------
CS2A_ALLOW_URL_IMPORT=true
# Allow plain http:// as well as https://. Off by default.
CS2A_ALLOW_HTTP_IMPORT=false
# Permit URLs resolving to private/loopback addresses. NEVER enable outside an
# isolated test environment — it defeats the SSRF guard entirely.
CS2A_ALLOW_PRIVATE_IMPORT=false

# --- Frontend ----------------------------------------------------------------
# Serve frontend/dist from FastAPI (production single-origin mode).
CS2A_SERVE_FRONTEND=false
